<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: #0a0e27;" spacing="0">

    <!-- HEADER -->
    <VBox style="-fx-alignment: center; -fx-background: linear-gradient(to bottom, #1a1a3e 0%, #2d1b4e 50%, #1a0f3e 100%); -fx-padding: 40 30 40 30;" spacing="20">

        <HBox style="-fx-alignment: center-right;">
            <Label text=" PRIMA RELEASE v1.0"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-padding: 5 15 5 15; -fx-border-color: #d4af37; -fx-border-width: 1; -fx-border-radius: 5;"/>
        </HBox>

        <Label text="═══════════════════════════════════════════════════════"
               style="-fx-font-size: 12px; -fx-text-fill: #d4af37; -fx-font-family: 'Courier New';"/>

        <Label text="⚔ DUNGEON LEGEND ⚔"
               style="-fx-font-size: 44px; -fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-effect: dropshadow(gaussian, #000000, 8, 0, 0, 2);"/>

        <Label text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
               style="-fx-font-size: 12px; -fx-text-fill: #8b7355; -fx-font-family: 'Courier New';"/>

        <Label text="«Il tuo destino ti chiama...»"
               style="-fx-font-size: 16px; -fx-font-style: italic; -fx-text-fill: #c0a080;"/>

        <Label text="Un'antica profezia parla di un eroe che sconfiggerà le creature oscure.&#10;Sarai tu? Crea il tuo personaggio e sfida l'abisso."
               style="-fx-font-size: 12px; -fx-text-fill: #a0a0a0; -fx-wrap-text: true; -fx-text-alignment: center; -fx-line-spacing: 5;"/>

        <Label text="═══════════════════════════════════════════════════════"
               style="-fx-font-size: 12px; -fx-text-fill: #d4af37; -fx-font-family: 'Courier New';"/>
    </VBox>

    <!-- CENTER CON SCROLL -->
    <ScrollPane fitToWidth="true" fitToHeight="false"
                style="-fx-padding: 0; -fx-control-inner-background: #0a0e27;"
                VBox.vgrow="ALWAYS">

        <VBox style="-fx-background-color: #0a0e27; -fx-padding: 40 50 50 50;" spacing="30">

            <HBox spacing="30">

                <!-- PANNELLO SINISTRO -->
                <VBox style="-fx-padding: 20; -fx-background-color: #1a1a3e; -fx-border-color: #8b7355; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, #000000, 15, 0, 0, 5);" spacing="15">

                    <Label text="📖 LA TUA LEGGENDA"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #d4af37;"/>

                    <Label text="• Vita: 100&#10;• Attacco: 10&#10;• Difesa: 5&#10;• Pozioni: 3"
                           style="-fx-font-size: 11px; -fx-text-fill: #c0a080; -fx-line-spacing: 8;"/>

                    <Separator style="-fx-border-color: #8b7355;"/>

                    <Label text="«Un eroe saggio sa che&#10;la forza non è tutto.&#10;La strategia vince le battaglie.»"
                           style="-fx-font-size: 11px; -fx-text-fill: #a0a0a0; -fx-font-style: italic; -fx-line-spacing: 5; -fx-wrap-text: true;"/>
                </VBox>

                <!-- PANNELLO DESTRO -->
                <VBox HBox.hgrow="ALWAYS" spacing="20">

                    <!-- Nome -->
                    <VBox style="-fx-padding: 20; -fx-border-color: #d4af37; -fx-border-width: 2; -fx-background-color: #1a0f3e; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, #d4af37, 8, 0.3, 0, 3);" spacing="10">

                        <Label text="👤 NOME DELL'EROE"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-letter-spacing: 2;"/>

                        <TextField fx:id="nameField" promptText="Scrivi il nome del tuo eroe..."
                                   style="-fx-padding: 12; -fx-font-size: 12px; -fx-control-inner-background: #0a0e27; -fx-text-fill: #d4af37; -fx-prompt-text-fill: #666666; -fx-border-color: #8b7355; -fx-border-width: 1; -fx-border-radius: 5; -fx-focus-color: #d4af37; -fx-faint-focus-color: #d4af3722;"/>
                    </VBox>

                    <!-- Genere -->
                    <VBox style="-fx-padding: 20; -fx-border-color: #d4af37; -fx-border-width: 2; -fx-background-color: #1a0f3e; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, #d4af37, 8, 0.3, 0, 3);" spacing="10">

                        <Label text="⚡ GENERE"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-letter-spacing: 2;"/>

                        <ComboBox fx:id="genderBox"
                                  style="-fx-padding: 10; -fx-font-size: 12px; -fx-control-inner-background: #0a0e27; -fx-text-fill: #d4af37; -fx-border-color: #8b7355; -fx-border-width: 1; -fx-border-radius: 5;"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- BOTTONE -->
            <VBox style="-fx-alignment: center;">
                <Button fx:id="createBtn" text="  🗡 ENTRA NELL'ABISSO 🗡  " onAction="#onCreateButtonClicked"
                        style="-fx-padding: 18 60 18 60; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-color: linear-gradient(to right, #d4af37, #ffdb58); -fx-text-fill: #1a0f3e; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, #d4af37, 10, 0.6, 0, 5); -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>